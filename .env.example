# SvelteKit / browser-safe Supabase values
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_PUBLISHABLE_KEY=
PUBLIC_SITE_URL=http://localhost:5173

# PHP API server values. These can point to the same public URL/key.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Optional. Keep server-only. Never expose with a PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=
