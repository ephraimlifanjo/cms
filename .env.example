APP_URL=http://localhost:8000
CMS_SITE_NAME=Nova CMS
CMS_ADMIN_USERNAME=admin

# Local demo only. Nova CMS also uses admin / 1234 automatically with `php -S`.
# NEVER reuse 1234 on a public production deployment.
CMS_ADMIN_PASSWORD=1234
CMS_SEED_DEMO=1

# Production: replace the demo password and use a persistent remote database.
# CMS_ADMIN_PASSWORD=replace-with-a-long-random-password
# DATABASE_URL=mysql://user:password@host:3306/database
# DATABASE_URL=postgresql://user:password@host:5432/database

# Local fallback only:
SQLITE_PATH=storage/cms.sqlite
